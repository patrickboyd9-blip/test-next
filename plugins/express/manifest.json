{
  "testId": "modern-mail-postcard",
  "name": "Modern Mail",
  "version": "1.0.0",
  "manifestVersion": 2,
  "requirements": {
    "apps": [{ "name": "Express", "apiVersion": 1 }]
  },
  "entryPoints": [
    {
      "type": "panel",
      "id": "modernMail",
      "main": "index.html",
      "documentSandbox": "sandbox/code.js",
      "permissions": {
        "sandbox": ["allow-popups", "allow-downloads"]
      }
    }
  ]
}
