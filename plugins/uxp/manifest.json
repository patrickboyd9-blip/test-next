{
  "manifestVersion": 5,
  "id": "com.modernmail.postcard",
  "name": "Modern Mail",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    { "app": "PS", "minVersion": "24.2.0" },
    { "app": "ID", "minVersion": "18.5.0" }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "modernMailPanel",
      "label": { "default": "Modern Mail" },
      "minimumSize": { "width": 320, "height": 520 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "localFileSystem": "request"
  }
}
